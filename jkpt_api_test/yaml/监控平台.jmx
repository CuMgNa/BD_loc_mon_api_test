        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="获取当前时间转换成时间戳（16进制）-15" enabled="true">
            <stringProp name="BeanShellSampler.query">// 获取当前时间戳（秒级）
long currentSeconds = System.currentTimeMillis() / 1000;

// 生成5个递减时间点（每步10秒）
long[] deltas = new long[5];
for (int i = 0; i &lt; 5; i++) {
    deltas[i] = currentSeconds - (5 * (i + 1));
}

// 存储基准时间变量
vars.put(&quot;hexNow&quot;, Long.toHexString(currentSeconds).toUpperCase());

// 存储各时间点变量（兼容BeanShell语法）
vars.put(&quot;hexMin1&quot;, Long.toHexString(deltas[0]).toUpperCase());
vars.put(&quot;hexMin2&quot;, Long.toHexString(deltas[1]).toUpperCase());
vars.put(&quot;hexMin3&quot;, Long.toHexString(deltas[2]).toUpperCase());
vars.put(&quot;hexMin4&quot;, Long.toHexString(deltas[3]).toUpperCase());
vars.put(&quot;hexMin5&quot;, Long.toHexString(deltas[4]).toUpperCase());

// 验证日志输出（使用字符串拼接）
log.info(&quot;===== 时间校验 =====&quot;);
log.info(&quot;基准时间(秒): &quot; + currentSeconds);
log.info(&quot;HEX基准值  : 0x&quot; + vars.get(&quot;hexNow&quot;));

for (int i = 0; i &lt; 5; i++) {
    String logMsg = &quot;前&quot; + (i + 1) + &quot;个10秒变量: hexMin&quot; + (i + 1)
            + &quot;=0x&quot; + vars.get(&quot;hexMin&quot; + (i + 1))
            + &quot; → 差值=&quot; + (currentSeconds - deltas[i]) + &quot;秒&quot;;
    log.info(logMsg);
}</stringProp>
          </BeanShellSampler>
