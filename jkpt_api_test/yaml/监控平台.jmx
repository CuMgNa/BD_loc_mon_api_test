          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="获取时间（16进制）" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;

// 获取当前日期
Date currentDate = new Date();

// ✅ 关键改动：强制指定时区为 UTC+8
TimeZone tz = TimeZone.getTimeZone(&quot;Asia/Shanghai&quot;);
Calendar calendar = Calendar.getInstance(tz);
calendar.setTime(currentDate);

// 获取年、月、日、时、分、秒（已经是 UTC+8 时间，无需手动减8）
int year = calendar.get(Calendar.YEAR) % 100;
int currentMonth = calendar.get(Calendar.MONTH) + 1;
int day = calendar.get(Calendar.DAY_OF_MONTH);
int hour = calendar.get(Calendar.HOUR_OF_DAY);  // 已经是 UTC+8 的小时
int minute = calendar.get(Calendar.MINUTE);
int second = calendar.get(Calendar.SECOND);

// 如果还需要 UTC+0 的时间
TimeZone utcTz = TimeZone.getTimeZone(&quot;UTC&quot;);
Calendar utcCalendar = Calendar.getInstance(utcTz);
utcCalendar.setTime(currentDate);
int hour_utc = utcCalendar.get(Calendar.HOUR_OF_DAY);

// 补零函数
def padHex(int num) {
    num = num &lt; 0 ? (num &amp; 0xFF) : num;
    return String.format(&quot;%02X&quot;, num);
}

// 生成十六进制字符串
def hexyear = padHex(year);
def hexMonth = padHex(currentMonth);
def hexday = padHex(day);
def hexhour = padHex(hour);         // UTC+8 小时
def hexhour_utc = padHex(hour_utc); // UTC+0 小时
def hexminute = padHex(minute);
def hexsecond = padHex(second);

// 存储为 JMeter 变量
vars.put(&quot;hexyear&quot;, hexyear);
vars.put(&quot;hexMonth&quot;, hexMonth);
vars.put(&quot;hexday&quot;, hexday);
vars.put(&quot;hexhour&quot;, hexhour);
vars.put(&quot;hexhour_utc&quot;, hexhour_utc);
vars.put(&quot;hexminute&quot;, hexminute);
vars.put(&quot;hexsecond&quot;, hexsecond);

// 日志输出
log.info(&quot;UTC+8 -&gt; hexyear: ${hexyear}, hexMonth: ${hexMonth}, hexday: ${hexday}&quot;);
log.info(&quot;UTC+8 -&gt; hexhour: ${hexhour}, hexminute: ${hexminute}, hexsecond: ${hexsecond}&quot;);
log.info(&quot;UTC+0 -&gt; hexhour_utc: ${hexhour_utc}&quot;);</stringProp>
          </JSR223Sampler>
