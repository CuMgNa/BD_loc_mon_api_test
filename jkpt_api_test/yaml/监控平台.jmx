        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="随机获取定位">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.util.Random
import java.nio.ByteBuffer
import java.nio.ByteOrder
import org.apache.jmeter.threads.JMeterContextService

// ================== 坐标转换工具类 ==================
class CoordinateConverter {
    static double pi = Math.PI
    static double a = 6378245.0
    static double ee = 0.00669342162296594323

    static def gcj02ToWgs84(double lng, double lat) {
        def d = delta(lng, lat)
        return [lng - d[0], lat - d[1]]
    }

    static def wgs84ToGcj02(double lng, double lat) {
        def d = delta(lng, lat)
        return [lng + d[0], lat + d[1]]
    }

    private static def delta(double lng, double lat) {
        def dLng = transformLng(lng - 105.0, lat - 35.0)
        def dLat = transformLat(lng - 105.0, lat - 35.0)
        def radLat = lat / 180.0 * pi
        def magic = Math.sin(radLat)
        magic = 1 - ee * magic * magic
        def sqrtMagic = Math.sqrt(magic)
        dLng = (dLng * 180.0) / (a / sqrtMagic * Math.cos(radLat) * pi)
        dLat = (dLat * 180.0) / ((a * (1 - ee)) / (magic * sqrtMagic) * pi)
        return [dLng, dLat]
    }

    private static def transformLng(double x, double y) {
        def ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x))
        ret += (20.0 * Math.sin(6.0 * x * pi) + 20.0 * Math.sin(2.0 * x * pi)) * 2.0 / 3.0
        ret += (20.0 * Math.sin(x * pi) + 40.0 * Math.sin(x / 3.0 * pi)) * 2.0 / 3.0
        ret += (150.0 * Math.sin(x / 12.0 * pi) + 300.0 * Math.sin(x / 30.0 * pi)) * 2.0 / 3.0
        return ret
    }

    private static def transformLat(double x, double y) {
        def ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x))
        ret += (20.0 * Math.sin(6.0 * x * pi) + 20.0 * Math.sin(2.0 * x * pi)) * 2.0 / 3.0
        ret += (20.0 * Math.sin(y * pi) + 40.0 * Math.sin(y / 3.0 * pi)) * 2.0 / 3.0
        ret += (160.0 * Math.sin(y / 12.0 * pi) + 320.0 * Math.sin(y * pi / 30.0)) * 2.0 / 3.0
        return ret
    }
}

// ================== 工具函数 ==================
def decimalToDMS(decimal, isLatitude) {
    def absDecimal = Math.abs(decimal)
    int degrees = (int) absDecimal
    double remaining = (absDecimal - degrees) * 60
    int minutes = (int) remaining
    double seconds = (remaining - minutes) * 60
    def direction = isLatitude? (decimal &gt;= 0? &apos;N&apos; : &apos;S&apos;) : (decimal &gt;= 0? &apos;E&apos; : &apos;W&apos;)
    return String.format(&quot;%d°%02d&apos;%06.3f\&quot;%s&quot;, degrees, minutes, seconds, direction)
}

def generateRandomPoint(centerLat, centerLon, radius) {
    Random rand = new Random()
    double angle = rand.nextDouble() * 2 * Math.PI
    double distance = radius * Math.sqrt(rand.nextDouble())
    
    double deltaNorth = distance * Math.cos(angle)
    double deltaEast = distance * Math.sin(angle)
    
    double latDelta = deltaNorth / 110574.0
    double lonDelta = deltaEast / (111320.0 * Math.cos(Math.toRadians(centerLat)))
    
    return [centerLon + lonDelta, centerLat + latDelta]
}

def generateTrajectory(startLon, startLat, steps, distance) {
    def points = []
    Random rand = new Random()
    double angle = rand.nextDouble() * 2 * Math.PI
    
    double deltaX = distance * Math.cos(angle)
    double deltaY = distance * Math.sin(angle)
    
    double lonDelta = deltaX / (111320.0 * Math.cos(Math.toRadians(startLat)))
    double latDelta = deltaY / 110574.0
    
    (steps + 1).times { i -&gt;
        def newLon = startLon + lonDelta * i
        def newLat = startLat + latDelta * i
        points &lt;&lt; [newLon, newLat]
    }
    return points
}

def calculateDistance(lon1, lat1, lon2, lat2) {
    double R = 6371000 // 地球半径（米）
    double dLat = Math.toRadians(lat2 - lat1)
    double dLon = Math.toRadians(lon2 - lon1)
    double a = Math.sin(dLat/2) * Math.sin(dLat/2) +
               Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2)) *
               Math.sin(dLon/2) * Math.sin(dLon/2)
    double c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))
    return R * c
}

def convertToSpecialHex(double value, int bytes) {
    int scaled = (value * 1e6).toInteger()
    ByteBuffer buffer = ByteBuffer.allocate(bytes)
    buffer.order(ByteOrder.BIG_ENDIAN)
    if (bytes == 4) {
        buffer.putInt(scaled)
    } else if (bytes == 2) {
        buffer.putShort((short)scaled)
    }
    return buffer.array().encodeHex().toString().toUpperCase()
}

def convertToHex(double lon, double lat) {
    return [
        lon: convertToSpecialHex(lon, 4),
        lat: convertToSpecialHex(lat, 4)
    ]
}

def dmsToHexComponents(double decimal, boolean isLongitude) {
    def directionChar = isLongitude? (decimal &gt;= 0? &apos;E&apos; : &apos;W&apos;) : (decimal &gt;= 0? &apos;N&apos; : &apos;S&apos;)
    def dms = decimalToDMS(decimal, isLongitude? false : true)
    def pattern = ~/(\d+)°(\d+)&apos;(\d+\.\d+)&quot;([NSWE])/
    def matcher = pattern.matcher(dms)
    if (!matcher.find()) throw new IllegalArgumentException(&quot;无效的DMS格式: ${dms}&quot;)

    int degrees = matcher.group(1).toInteger()
    int minutes = matcher.group(2).toInteger()
    double seconds = matcher.group(3).toDouble()

    // 处理方向（通过分的最高位表示）
    if (isLongitude) { // 经度
        if (directionChar == &apos;W&apos;) {
            minutes |= 0x80 // 最高位设为1（西经）
        } else {
            minutes &amp;= 0x7F // 最高位设为0（东经）
        }
    } else { // 纬度
        if (directionChar == &apos;S&apos;) {
            minutes |= 0x80 // 最高位设为1（南纬）
        } else {
            minutes &amp;= 0x7F // 最高位设为0（北纬）
        }
    }

    // 度（两位16进制）
    String degHex = String.format(&quot;%02X&quot;, degrees)
    // 分（两位16进制，含方向标志）
    String minHex = String.format(&quot;%02X&quot;, minutes)
    // 秒（两位16进制）
    int secInt = (int) seconds
    String secHex = String.format(&quot;%02X&quot;, secInt)
    // 小秒（取小数点后两位，转两位16进制）
    int subsecInt = ((seconds - secInt) * 100).toInteger()
    String subsecHex = String.format(&quot;%02X&quot;, subsecInt)

    return [
        deg: degHex,
        min: minHex,
        sec: secHex,
        subsec: subsecHex,
        full: degHex + minHex + secHex + subsecHex
    ]
}

// ================== 主逻辑 ==================
def vars = JMeterContextService.getContext().getVariables()
def threadId = Thread.currentThread().getId()

// 初始化坐标中心点
def centerLat = 23.170439
def centerLon = 113.466203

// 初始化或获取起始点
def gcjStartPoint = vars.getObject(&quot;gcjStartPoint_${threadId}&quot;)
if (!gcjStartPoint) {
    def randomPoint = generateRandomPoint(centerLat, centerLon, 100)
    gcjStartPoint = [lon: randomPoint[0], lat: randomPoint[1]]
    vars.putObject(&quot;gcjStartPoint_${threadId}&quot;, gcjStartPoint)
}

// 坐标转换
def (wgsLon, wgsLat) = CoordinateConverter.gcj02ToWgs84(gcjStartPoint.lon, gcjStartPoint.lat)

// 生成轨迹（18个点，间隔10米）
def trajectory = generateTrajectory(wgsLon, wgsLat, 17, 10)

// 处理每个轨迹点
trajectory.eachWithIndex { wgsPoint, index -&gt;
    def pointNumber = index + 1
    def isSpecialPoint = (pointNumber &gt;= 5 &amp;&amp; pointNumber &lt;= 10) || (pointNumber &gt;= 16 &amp;&amp; pointNumber &lt;= 18)

    // 转换为GCJ02
    def (gcjLon, gcjLat) = CoordinateConverter.wgs84ToGcj02(wgsPoint[0], wgsPoint[1])
    
    // GCJ-02坐标的度分秒格式
    def gcjLonDms = decimalToDMS(gcjLon, false)
    def gcjLatDms = decimalToDMS(gcjLat, true)

    // 存储基础坐标
    vars.put(&quot;loc${pointNumber}_wgs_lon&quot;, String.format(&quot;%.6f&quot;, wgsPoint[0]))
    vars.put(&quot;loc${pointNumber}_wgs_lat&quot;, String.format(&quot;%.6f&quot;, wgsPoint[1]))

    if (isSpecialPoint) {
        // 处理经度
        def lonDms = dmsToHexComponents(wgsPoint[0], true)
        vars.put(&quot;loc${pointNumber}_lon_deg_hex&quot;, lonDms.deg)
        vars.put(&quot;loc${pointNumber}_lon_min_hex&quot;, lonDms.min)
        vars.put(&quot;loc${pointNumber}_lon_sec_hex&quot;, lonDms.sec)
        vars.put(&quot;loc${pointNumber}_lon_subsec_hex&quot;, lonDms.subsec)

        // 处理纬度
        def latDms = dmsToHexComponents(wgsPoint[1], false)
        vars.put(&quot;loc${pointNumber}_lat_deg_hex&quot;, latDms.deg)
        vars.put(&quot;loc${pointNumber}_lat_min_hex&quot;, latDms.min)
        vars.put(&quot;loc${pointNumber}_lat_sec_hex&quot;, latDms.sec)
        vars.put(&quot;loc${pointNumber}_lat_subsec_hex&quot;, latDms.subsec)

        // 完整HEX
        def lonFullHex = lonDms.full
        def latFullHex = latDms.full

        vars.put(&quot;loc${pointNumber}_lon_dms_full_hex&quot;, lonFullHex)
        vars.put(&quot;loc${pointNumber}_lat_dms_full_hex&quot;, latFullHex)

        // 日志输出
        log.info(&quot;┌────────────── 点位${pointNumber} ──────────────&quot;)
        log.info(&quot;│ 经度组件: 度=${lonDms.deg} 分=${lonDms.min} 秒=${lonDms.sec} 小秒=${lonDms.subsec}&quot;)
        log.info(&quot;│ 纬度组件: 度=${latDms.deg} 分=${latDms.min} 秒=${latDms.sec} 小秒=${latDms.subsec}&quot;)
        log.info(&quot;│ 经度完整HEX: ${lonFullHex}&quot;)
        log.info(&quot;│ 纬度完整HEX: ${latFullHex}&quot;)
        log.info(&quot;│ GCJ02坐标: ${String.format(&quot;%.6f, %.6f&quot;, gcjLon, gcjLat)}&quot;)
        log.info(&quot;│ GCJ02度分秒: ${gcjLonDms} ${gcjLatDms}&quot;)  // 新增GCJ-02度分秒
    } else {
        // 其他点保持原有逻辑
        def hexData = convertToHex(wgsPoint[0], wgsPoint[1])
        vars.put(&quot;loc${pointNumber}_hex_lon&quot;, hexData.lon)
        vars.put(&quot;loc${pointNumber}_hex_lat&quot;, hexData.lat)
        log.info(&quot;┌────────────── 点位${pointNumber} ──────────────&quot;)
        log.info(&quot;│ 十六进制: 经度=${hexData.lon} 纬度=${hexData.lat}&quot;)
        log.info(&quot;│ GCJ02坐标: ${String.format(&quot;%.6f, %.6f&quot;, gcjLon, gcjLat)}&quot;)
        log.info(&quot;│ GCJ02度分秒: ${gcjLonDms} ${gcjLatDms}&quot;)  // 新增GCJ-02度分秒
    }

    // 公共日志输出
    log.info(&quot;│ WGS84坐标: ${String.format(&quot;%.6f, %.6f&quot;, wgsPoint[0], wgsPoint[1])}&quot;)
    log.info(&quot;│ WGS84度分秒: ${decimalToDMS(wgsPoint[0], false)} ${decimalToDMS(wgsPoint[1], true)}&quot;)
    log.info(&quot;│ GCJ02度分秒: ${gcjLonDms} ${gcjLatDms}&quot;)  // 公共部分重复添加（可根据需要调整）

    if (index &gt; 0) {
        def prevPoint = trajectory[index - 1]
        double distance = calculateDistance(prevPoint[0], prevPoint[1], wgsPoint[0], wgsPoint[1])
        log.info(&quot;│ 与上一点距离: ${distance.round(2)}米&quot;)
    }
    log.info(&quot;└──────────────────────────────────────&quot;)
}

// 更新下一轮起点
def lastPoint = trajectory.last()
def (nextGcjLon, nextGcjLat) = CoordinateConverter.wgs84ToGcj02(lastPoint[0], lastPoint[1])
vars.putObject(&quot;gcjStartPoint_${threadId}&quot;, [lon: nextGcjLon, lat: nextGcjLat])</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="文本（92,93）-语音（A5，A6）-文本（90,91）">
          <stringProp name="LoopController.loops">1</stringProp>
        </LoopController>
        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="获取当前时间转换成时间戳（16进制）" enabled="true">
            <stringProp name="BeanShellSampler.query">// 获取当前系统时间的时间戳（毫秒）
long currentTimeMillis = System.currentTimeMillis() / 1000;

// 八小时对应的秒数
long eightHoursInSeconds = 8 * 60 * 60;
 
// 计算减去八小时后的时间戳（秒）
long adjustedTimeSeconds = currentTimeMillis - eightHoursInSeconds;
 
// 输出调整后的时间戳（秒）
print(&quot;当前系统时间减去八小时后的时间戳（秒）: &quot; + adjustedTimeSeconds);

// 将时间戳转换为十六进制字符串
// 注意：Java中的Long.toHexString()方法返回的是不带&quot;0x&quot;前缀的十六进制字符串
String hexTimestamp = Long.toHexString(currentTimeMillis);

String hexTimestamp_utc = Long.toHexString(adjustedTimeSeconds);

String hexTimestamp_up = Long.toHexString(currentTimeMillis).toUpperCase();

// 如果需要加上&quot;0x&quot;前缀，可以手动添加
//String hexTimestampWithPrefix = &quot;0x&quot; + hexTimestamp;

// 将十六进制字符串设置为JMeter变量
// vars是JMeter提供的内置变量，用于存储和获取JMeter变量
vars.put(&quot;hexTimestamp&quot;, hexTimestamp);
vars.put(&quot;hexTimestamp_utc&quot;, hexTimestamp_utc);
vars.put(&quot;hexTimestamp_up&quot;, hexTimestamp_up);

// 打印变量到JMeter日志（可选，用于调试）
log.info(&quot;Current hex timestamp: &quot; + hexTimestamp);
log.info(&quot;Current hex hexTimestamp_utc: &quot; + hexTimestamp_utc);
log.info(&quot;Current hex hexTimestamp_up: &quot; + hexTimestamp_up);

</stringProp>
          </BeanShellSampler>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="固定定时器" enabled="false">
              <stringProp name="ConstantTimer.delay">10000</stringProp>
            </ConstantTimer>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="文本---92--无位置">
            <stringProp name="HTTPSampler.domain">${computerid}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/api/datas/bd</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;commInfos&quot;: [&#xd;
    {&#xd;
      &quot;commTime&quot;: &quot;&quot;,&#xd;
      &quot;content&quot;: &quot;92000690259E${hexTimestamp_up}C2E9B7B3B8F7CEBBB6D3D3D1B1A8D2BBCFC2D7D4BCBAB5C4CEBBD6C3&quot;,&#xd;
      &quot;fromAddr&quot;: &quot;${addrid}&quot;,&#xd;
      &quot;time&quot;: &quot;${__groovy(new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).with { it.timeZone = TimeZone.getTimeZone(&quot;Asia/Shanghai&quot;); it.format(new Date()) },)}&quot;,&#xd;
      &quot;toAddr&quot;: &quot;110110110&quot;&#xd;
    }&#xd;
  ],&#xd;
  &quot;receipts&quot;: [&#xd;
    {&#xd;
      &quot;fromAddr&quot;: &quot;string&quot;,&#xd;
      &quot;msg&quot;: &quot;string&quot;,&#xd;
      &quot;msgId&quot;: &quot;string&quot;,&#xd;
      &quot;sendTime&quot;: &quot;string&quot;,&#xd;
      &quot;status&quot;: 0,&#xd;
      &quot;toAddr&quot;: &quot;string&quot;&#xd;
    }&#xd;
  ]&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="固定定时器" enabled="true">
              <stringProp name="ConstantTimer.delay">10000</stringProp>
            </ConstantTimer>
            <hashTree/>
            <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="常数吞吐量定时器" enabled="false">
              <doubleProp>
                <name>throughput</name>
                <value>1.0</value>
                <savedValue>1.0</savedValue>
              </doubleProp>
