          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="随机获取方向">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.Random

Random random = new Random()

// 获取用户定义的变量，默认生成4个方位变量
int count = vars.get(&quot;direction_count&quot;) as Integer ?: 5

// 生成指定数量的方位变量
(1..count).each { index -&gt;
    // 1. 生成0-360度的随机角度
    int angle = random.nextInt(361)  // 0-360
    
    // 2. 直接使用角度值（因为360 &lt; 65535，所以不会超过2字节范围）
    int value = angle
    
    // 3. 转换为2字节(4位)16进制
    String hexValue = String.format(&quot;%04X&quot;, value)
    
    // 4. 设置JMeter变量
    vars.put(&quot;direction_angle_${index}&quot;, angle.toString())  // 原始角度值(0-360)
    vars.put(&quot;angle_hex_${index}&quot;, hexValue)                // 2字节16进制值
    
    // 5. 输出日志
    log.info(&quot;生成方位变量 #${index}:&quot;)
    log.info(&quot;原始角度: ${angle}度&quot;)
    log.info(&quot;16进制表示: 0x${hexValue} (${value}十进制)&quot;)
}

// 返回摘要信息
return &quot;&quot;&quot;
已生成 ${count} 个方位变量。变量命名规则:
- direction_angle_X: 原始角度值(0-360度)
- angle_hex_X: 2字节16进制值
(X为1-${count})

注意: 角度值直接转换为16进制，范围0x0000-0x0168，确保不超过2字节。
&quot;&quot;&quot;</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="获取时间（16进制）">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 导入必要的类
import java.util.Calendar;
import java.util.Date;

// 获取当前日期
Date currentDate = new Date();

// 使用Calendar类获取当前月份和时间
Calendar calendar = Calendar.getInstance();
calendar.setTime(currentDate);

// 获取年、月、日、时、分、秒
int year = calendar.get(Calendar.YEAR) % 100;
int currentMonth = calendar.get(Calendar.MONTH) + 1; // 月份从0开始，所以需要+1
int day = calendar.get(Calendar.DAY_OF_MONTH);
int hour = calendar.get(Calendar.HOUR_OF_DAY); // 24小时制
int hour_8 = calendar.get(Calendar.HOUR_OF_DAY) - 8; // 24小时制
int minute = calendar.get(Calendar.MINUTE);
int second = calendar.get(Calendar.SECOND);

// 转换成16进制
String hexyear = Long.toHexString(year).toUpperCase();
String hexMonth = Long.toHexString(currentMonth).toUpperCase();
String hexday = Long.toHexString(day).toUpperCase();
String hexhour = Long.toHexString(hour).toUpperCase();
String hexhour_8 = Long.toHexString(hour_8).toUpperCase();
String hexminute = Long.toHexString(minute).toUpperCase();
String hexsecond = Long.toHexString(second).toUpperCase();

// 补零至两位
while (hexyear.length() &lt; 2) {
    hexyear = &quot;0&quot; + hexyear;
}
while (hexMonth.length() &lt; 2) {
    hexMonth = &quot;0&quot; + hexMonth;
}
while (hexday.length() &lt; 2) {
    hexday = &quot;0&quot; + hexday;
}
while (hexhour.length() &lt; 2) {
    hexhour = &quot;0&quot; + hexhour;
}
while (hexminute.length() &lt; 2) {
    hexminute = &quot;0&quot; + hexminute;
}
while (hexsecond.length() &lt; 2) {
    hexsecond = &quot;0&quot; + hexsecond;
}

// 计算异或校验和函数
def calculateXorChecksum(String hexString) {
    // 移除可能存在的空格并转换为大写
    hexString = hexString.replaceAll(&quot;\\s&quot;, &quot;&quot;).toUpperCase()
    
    // 检查是否为合法的十六进制字符串
    if (!(hexString =~ /^[0-9A-F]+$/)) {
        throw new IllegalArgumentException(&quot;无效的十六进制字符串: ${hexString}&quot;)
    }
    
    // 确保字符串长度为偶数（每两个字符代表一个字节）
    if (hexString.length() % 2 != 0) {
        throw new IllegalArgumentException(&quot;十六进制字符串长度必须为偶数&quot;)
    }
    
    // 分割字符串为字节数组
    def bytes = []
    for (int i = 0; i &lt; hexString.length(); i += 2) {
        bytes.add(Integer.parseInt(hexString.substring(i, i + 2), 16))
    }
    
    // 计算异或校验和
    int xor = 0
    bytes.each { byteValue -&gt;
        xor = xor ^ byteValue
    }
    
    // 转换为两位十六进制字符串（大写）
    return String.format(&quot;%02X&quot;, xor)
}

// 构建待计算的十六进制字符串（从第2字节到第12字节）
def hexData = &quot;00A4${hexyear}${hexMonth}${hexday}${hexhour}${hexminute}${hexsecond}00050545&quot;

// 提取从第2字节到第12字节的部分进行计算
def dataToCalculate = hexData.substring(2, 24)  // 索引2到23，共11字节（22字符）

// 计算异或校验和
def xorChecksum = calculateXorChecksum(dataToCalculate)

// 存储为变量
vars.put(&quot;hexyear&quot;, hexyear)
vars.put(&quot;hexMonth&quot;, hexMonth)
vars.put(&quot;hexday&quot;, hexday)
vars.put(&quot;hexhour&quot;, hexhour)
vars.put(&quot;hexhour_8&quot;, hexhour_8)
vars.put(&quot;hexminute&quot;, hexminute)
vars.put(&quot;hexsecond&quot;, hexsecond)
vars.put(&quot;xor_checksum&quot;, xorChecksum)

// 输出变量到JMeter日志
log.info(&quot;当前时间: ${year}-${currentMonth}-${day} ${hour}:${minute}:${second}&quot;)
log.info(&quot;十六进制时间: ${hexyear}-${hexMonth}-${hexday} ${hexhour}:${hexminute}:${hexsecond}&quot;)
log.info(&quot;待计算数据: ${dataToCalculate}&quot;)
log.info(&quot;异或校验和: ${xorChecksum}&quot;)</stringProp>
          </JSR223Sampler>
